# ---------------------------------------------------------------------------
# Software Factory - configuración local
# Copia este archivo a .env y rellena los valores.
#
# Backlog: GitHub Issues del repo objetivo. La webapp pasa repo + issue URL.
# El runtime OpenCode del factory es independiente del OpenCode de tu máquina.
# No montes ~/.config/opencode ni ~/.local/share/opencode.
# ---------------------------------------------------------------------------

# Runtime de agentes ---------------------------------------------------------
OPENCODE_SERVER_PASSWORD=cambia-esta-password
OPENCODE_SERVER_USERNAME=opencode

# URL del servidor OpenCode del factory. Docker Compose la sobrescribe con
# http://opencode:4096. Para desarrollo en el host usa http://127.0.0.1:14096.
FACTORY_OPENCODE_URL=http://opencode:4096

# Modelo por defecto: provider/model[#variant].
# Ollama Cloud usa el provider integrado "ollama-cloud".
FACTORY_MODEL=ollama-cloud/deepseek-v4.1-flash:1017

# Credenciales de proveedores. Rellena solo las que uses.
# Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# GitHub (OBLIGATORIO) -------------------------------------------------------
# Token con Issues read/write, Contents read/write y Pull requests read/write.
# Recomendado: fine-grained PAT limitado a "Only select repositories" -> repo objetivo.
# Ojo: un fine-grained PAT no accede a repos privados de OTRA cuenta personal,
# aunque seas colaborador. En ese caso usa un PAT classic con scope "repo".
# Un PAT clásico con scope "repo" no se puede limitar a un solo repo.
GITHUB_TOKEN=

# Hints opcionales para los agentes; la factory no los ejecuta.
FACTORY_SETUP_CMD=
FACTORY_TEST_CMD=

# Etiquetas del workflow -----------------------------------------------------
# Etiquetas que la factoría aplica al issue durante el run.
# FACTORY_LABEL_READY es opcional: se crea y se retira al reclamar el issue.
FACTORY_LABEL_IN_PROGRESS=factory:in-progress
FACTORY_LABEL_IN_REVIEW=factory:in-review
FACTORY_LABEL_BLOCKED=factory:blocked
FACTORY_LABEL_READY=
FACTORY_SKIP_LABELS=factory:skip

# Entrega --------------------------------------------------------------------
# local: no hace push ni crea PR (sí comenta/etiqueta el issue).
# github: push + Pull Request. El PR incluye "Closes #<issue>".
FACTORY_DELIVERY_MODE=local
FACTORY_PR_DRAFT=false

# Auto-merge opcional. Requiere al menos una review APPROVED en GitHub, sin
# CHANGES_REQUESTED y con el PR mergeable. Desactivado por defecto.
FACTORY_AUTO_MERGE=false
FACTORY_MERGE_METHOD=squash
FACTORY_REWORK_ON_CHANGES_REQUESTED=true
FACTORY_TRIAGE_PR_COMMENTS=true
FACTORY_FEEDBACK_USERS=

# Comportamiento -------------------------------------------------------------
FACTORY_HOST_PORT=3000
WEB_HOST_PORT=8080
FACTORY_MAX_REWORK=3
# Intervalo de sincronización de runs entregados (reviews, auto-merge, cierre).
FACTORY_POLL_INTERVAL_MS=15000
FACTORY_WORKER_INTERVAL_MS=5000
# Timeout por agente: 1 hora (3600000 ms).
FACTORY_STEP_TIMEOUT_MS=3600000
FACTORY_TEST_TIMEOUT_MS=1200000
FACTORY_OPENCODE_STARTUP_TIMEOUT_MS=90000
FACTORY_AUTO_APPROVE_PERMISSIONS=true
FACTORY_GIT_AUTHOR_NAME=Software Factory
FACTORY_GIT_AUTHOR_EMAIL=factory@localhost
LOG_LEVEL=info

# API y autenticación de la webapp (OBLIGATORIO) -----------------------------
# Token interno entre la webapp y la API de la factory. La API exige
# "Authorization: Bearer <token>" en TODAS las rutas.
# Genera uno con: openssl rand -hex 32
FACTORY_API_TOKEN=
# Secreto para cifrar los JWT de sesión de NextAuth. Mínimo 32 caracteres.
# Genera uno con: openssl rand -hex 32
WEB_AUTH_SECRET=
# Opcional: si lo defines, el registro con email/contraseña exige este código.
WEB_REGISTRATION_CODE=
# Ponlo a true solo si sirves la webapp por HTTPS.
WEB_COOKIE_SECURE=false
# Duración de la sesión en horas (1-720).
WEB_SESSION_TTL_HOURS=168
# Origen público (opcional, para derivar cookies seguras detrás de HTTPS).
WEB_PUBLIC_ORIGIN=
# Opcional: conexión a la DB con permisos solo sobre users.
# Si está vacío, la webapp usa DATABASE_URL.
WEB_DATABASE_URL=

# OAuth2 / NextAuth -----------------------------------------------------------
# Rellena solo los proveedores que quieras habilitar. Los botones aparecen
# automáticamente en /login y /register.
# Callback: ${NEXTAUTH_URL}/api/auth/callback/<proveedor>
# Google Cloud Console -> OAuth Client ID (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Apple -> Services ID + client secret JWT (.p8). Requiere HTTPS público.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Microsoft Entra ID (el proveedor de NextAuth se llama azure-ad)
AUTH_AZURE_AD_ID=
AUTH_AZURE_AD_SECRET=
AUTH_AZURE_AD_TENANT_ID=common
# GitLab.com -> User Settings -> Applications
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=

# URL pública de la webapp para construir los callbacks OAuth.
# Local: http://localhost:8080. Producción: https://factory.example.com
NEXTAUTH_URL=http://localhost:8080
# Mantiene el origen del proxy (Host/X-Forwarded-Host). Déjalo en true.
AUTH_TRUST_HOST=true
# Opcional; si no se define se usa WEB_AUTH_SECRET.
NEXTAUTH_SECRET=

# Base de datos - leída desde .env --------------------------------------------
# Si cambias POSTGRES_PASSWORD, actualiza también DATABASE_URL.
POSTGRES_USER=factory
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=factory
DATABASE_URL=postgres://factory:cambia-esta-password@postgres:5432/factory
