{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI software factory: GitHub Issues -> OpenCode squad -> Pull Request",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/src/store && cp src/store/schema.sql dist/src/store/schema.sql",
    "web": "npm --prefix web run dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "github:check": "tsx scripts/github-check.ts",
    "opencode:check": "tsx scripts/opencode-check.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
